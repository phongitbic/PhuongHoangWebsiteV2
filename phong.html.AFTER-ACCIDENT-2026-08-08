  <script>
    function setLanguage(lang) {
      document.documentElement.lang = lang;
      var btns = document.querySelectorAll('.lang-btn');
      btns.forEach(function(b){ b.classList.remove('active'); });
      var active = document.querySelector('.lang-btn[onclick*="setLanguage(\'' + lang + '\')"]');
      if (active) active.classList.add('active');
    }

    /* Inject shared header & footer */
    (function () {
      var h = document.getElementById('shared-header');
      var f = document.getElementById('shared-footer');
      if (h && window.__PH_COMPONENTS__ && window.__PH_COMPONENTS__.header) {
        h.innerHTML = window.__PH_COMPONENTS__.header;
      }
      if (f && window.__PH_COMPONENTS__ && window.__PH_COMPONENTS__.footer) {
        f.innerHTML = window.__PH_COMPONENTS__.footer;
      }
    })();

    /* FAQ two-column panel — tablist pattern with keyboard nav */
    (function () {
      var tabs = document.querySelectorAll('.bp-faq-tab');
      var answers = document.querySelectorAll('.bp-faq-answer');
      if (!tabs.length) return;

      function selectTab(tabEl) {
        var idx = tabEl.getAttribute('data-faq');
        tabs.forEach(function (t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('aria-expanded', 'false');
        });
        answers.forEach(function (a) { a.classList.remove('is-active'); });
        tabEl.classList.add('active');
        tabEl.setAttribute('aria-selected', 'true');
        tabEl.setAttribute('aria-expanded', 'true');
        var target = document.querySelector('.bp-faq-answer[data-faq="' + idx + '"]');
        if (target) { target.classList.add('is-active'); target.setAttribute('tabindex', '-1'); target.focus({ preventScroll: true }); }
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () { selectTab(this); });
        tab.addEventListener('keydown', function (e) {
          var idx = Array.prototype.indexOf.call(tabs, this);
          var next;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            next = tabs[idx + 1] || tabs[0];
            next.focus();
            selectTab(next);
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            next = tabs[idx - 1] || tabs[tabs.length - 1];
            next.focus();
            selectTab(next);
          } else if (e.key === 'Home') {
            e.preventDefault();
            tabs[0].focus();
            selectTab(tabs[0]);
          } else if (e.key === 'End') {
            e.preventDefault();
            tabs[tabs.length - 1].focus();
            selectTab(tabs[tabs.length - 1]);
          }
        });
      });
    })();

    /* Certificate lightbox — full modal with keyboard/click-dismiss */
    (function () {
      var lb = document.getElementById('certLightbox');
      var img = document.getElementById('certLightboxImg');
      var triggers = document.querySelectorAll('.bp-cert-trigger');
      if (!lb || !img || !triggers.length) return;

      var lastFocused = null;

      function open(src, alt) {
        lastFocused = document.activeElement;
        img.src = src;
        img.alt = alt;
        lb.hidden = false;
        lb.querySelector('.bp-lightbox-close').focus();
        document.addEventListener('keydown', onKey);
      }

      function close() {
        lb.hidden = true;
        img.src = '';
        img.alt = '';
        document.removeEventListener('keydown', onKey);
        if (lastFocused) { lastFocused.focus(); lastFocused = null; }
      }

      function onKey(e) {
        if (e.key === 'Escape') { e.preventDefault(); close(); }
        if (e.key === 'Tab') {
          var focusable = lb.querySelectorAll('button, [tabindex]:not([tabindex="-1"])');
          if (!focusable.length) return;
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      }

      triggers.forEach(function (btn) {
        btn.addEventListener('click', function () {
          open(btn.getAttribute('data-cert'), btn.getAttribute('data-label'));
        });
      });

      lb.querySelector('.bp-lightbox-backdrop').addEventListener('click', close);
      lb.querySelector('.bp-lightbox-close').addEventListener('click', close);
    })();
  </script>

