  <script>
    function setLanguage(lang) {
      document.documentElement.lang = lang;
      var btns = document.querySelectorAll('.lang-btn');
      btns.forEach(function (b) { b.classList.remove('active'); });
      var active = document.querySelector('.lang-btn[onclick*="setLanguage(\'' + lang + '\')"]');
      if (active) active.classList.add('active');
    }

    /* Load shared header & footer */
    (function () {
      var diag = document.getElementById('ph-diag');
      var lines = [];
      lines.push('URL: ' + window.location.href);
      lines.push('Protocol: ' + window.location.protocol);

      var els = [
        { id: 'shared-header', url: 'assets/components/header.html' },
        { id: 'shared-footer', url: 'assets/components/footer.html' }
      ];
      var pending = els.length;
      els.forEach(function (el) {
        var container = document.getElementById(el.id);
        if (!container) {
          lines.push('ERR: ' + el.id + ' container missing');
          pending--; if (!pending && diag) diag.innerHTML = lines.join('<br>');
          return;
        }
        var xhr = new XMLHttpRequest();
        xhr.open('GET', el.url, true);
        xhr.onload = function () {
          lines.push(el.id + ': HTTP ' + xhr.status + ' (' + xhr.responseText.length + ' bytes)');
          if (xhr.status >= 200 && xhr.status < 300) {
            container.innerHTML = xhr.responseText;
            lines.push(el.id + ': injected, ' + container.children.length + ' children');
          }
          pending--; if (!pending && diag) diag.innerHTML = lines.join('<br>');
        };
        xhr.onerror = function () {
          lines.push('ERR: ' + el.id + ' XHR failed (readyState=' + xhr.readyState + ', status=' + xhr.status + ')');
          pending--; if (!pending && diag) diag.innerHTML = lines.join('<br>');
        };
        xhr.send();
      });

      // Timeout fallback
      setTimeout(function () {
        if (pending > 0) {
          lines.push('TIMEOUT: ' + pending + ' requests still pending');
          if (diag) diag.innerHTML = lines.join('<br>');
        }
      }, 5000);
    })();

    /* FAQ two-column panel */
    (function () {
      var tabs = document.querySelectorAll('.bp-faq-tab');
      var answers = document.querySelectorAll('.bp-faq-answer');
      if (!tabs.length) return;
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var idx = this.getAttribute('data-faq');
          tabs.forEach(function (t) { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
          answers.forEach(function (a) { a.classList.remove('is-active'); });
          this.classList.add('active');
          this.setAttribute('aria-selected', 'true');
          var target = document.querySelector('.bp-faq-answer[data-faq="' + idx + '"]');
          if (target) target.classList.add('is-active');
        });
      });
    })();
  </script>

