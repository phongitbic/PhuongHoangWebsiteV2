/* ===================================
   Homepage — Phượng Hoàng V2
   Each section has a unique layout family.
   No two sections share the same pattern.
   =================================== */

/* ═══════════ 1. ABOUT TTE (2-col split + stats row + CTA) ═══════════ */
.about-tte-container {
  max-width: var(--ph-container-wide);
  margin: 0 auto;
  padding: 0 var(--ph-space-md);
}
@media (max-width: 767px) { .about-tte-container { padding: 0 var(--ph-space-sm); } }

.about-tte-main {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-space-xl);
  align-items: center;
  margin-bottom: var(--ph-space-2xl);
}
@media (min-width: 768px) { .about-tte-main { grid-template-columns: 5fr 4fr; gap: var(--ph-space-2xl); } }

.about-tte-intro {
  font: var(--ph-text-body);
  color: var(--ph-text-secondary);
  margin-bottom: var(--ph-space-md);
}
.about-tte-intro strong { color: var(--ph-text-primary); }

.about-tte-products-heading {
  font: var(--ph-text-h4);
  color: var(--ph-text-primary);
  margin-bottom: var(--ph-space-sm);
}

.about-tte-product-list {
  display: flex;
  flex-direction: column;
  gap: var(--ph-space-2xs);
}
.about-tte-product-list span {
  display: flex;
  align-items: center;
  gap: var(--ph-space-2xs);
  font: var(--ph-text-body-sm);
  color: var(--ph-text-secondary);
}

/* Video card */
.about-tte-video-card {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-lg);
  overflow: hidden;
  cursor: pointer;
  box-shadow: var(--ph-shadow-inner-highlight);
  transition: transform var(--ph-duration-normal) var(--ph-ease-spring),
              box-shadow var(--ph-duration-normal) var(--ph-ease-out),
              border-color var(--ph-duration-fast) var(--ph-ease-out);
}
.about-tte-video-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--ph-shadow-2), var(--ph-shadow-inner-highlight);
  border-color: var(--ph-accent);
}
.vid-thumb {
  aspect-ratio: 16 / 9;
  background: linear-gradient(135deg, var(--ph-bg-tertiary), var(--ph-surface-secondary));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--ph-space-sm);
  position: relative;
}
.vid-thumb-icon { font-size: var(--ph-icon-2xl); }
.vid-play-btn {
  width: 60px; height: 60px;
  border-radius: 50%;
  background: var(--ph-accent);
  border: none;
  color: white;
  font-size: 22px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--ph-duration-fast) var(--ph-ease-spring);
  padding-left: 3px;
}
.vid-play-btn:hover { transform: scale(1.08); }
.vid-thumb-label {
  font: var(--ph-text-caption);
  color: var(--ph-text-secondary);
}
.about-tte-video-badge {
  padding: var(--ph-space-sm) var(--ph-space-md);
  display: flex;
  align-items: center;
  gap: var(--ph-space-2xs);
  font: var(--ph-text-caption);
  color: var(--ph-accent);
}

/* Stats row */
.about-tte-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--ph-space-md);
  margin-bottom: var(--ph-space-xl);
}
@media (min-width: 768px) { .about-tte-stats { grid-template-columns: repeat(4, 1fr); } }

.about-tte-stat-item {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-lg);
  padding: var(--ph-space-md);
  text-align: center;
  box-shadow: var(--ph-shadow-inner-highlight);
}
.about-tte-stat-icon,
.about-tte-stat-num {
  font-size: var(--ph-icon-2xl);
  display: block;
  margin-bottom: var(--ph-space-xs);
}
.about-tte-stat-label {
  font: var(--ph-text-caption);
  color: var(--ph-text-secondary);
}
.about-tte-cta {
  display: flex;
  gap: var(--ph-space-sm);
  flex-wrap: wrap;
  justify-content: center;
}

/* ═══════════ 2. ELECTRICAL RISKS (list + sticky illustration) ═══════════ */
.risks-section {
  background: var(--ph-bg-secondary);
}
.risks-container {
  max-width: var(--ph-container-wide);
  margin: 0 auto;
  padding: 0 var(--ph-space-md);
}
@media (max-width: 767px) { .risks-container { padding: 0 var(--ph-space-sm); } }

.risks-header { text-align: center; margin-bottom: var(--ph-space-xl); }
.warning-line {
  display: inline-block;
  padding: var(--ph-space-2xs) var(--ph-space-sm);
  background: var(--ph-warning-subtle);
  color: var(--ph-warning);
  border-radius: var(--ph-radius-full);
  font: var(--ph-text-overline);
  letter-spacing: var(--ph-tracking-wide);
  text-transform: uppercase;
  margin-bottom: var(--ph-space-sm);
}
.risks-header h2 {
  font: var(--ph-text-h2);
  margin-bottom: var(--ph-space-sm);
  letter-spacing: var(--ph-tracking-tight);
}
.risks-header p {
  font: var(--ph-text-body-lg);
  color: var(--ph-text-secondary);
  max-width: 560px;
  margin: 0 auto;
}

.risks-body {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-space-xl);
  align-items: start;
}
@media (min-width: 768px) { .risks-body { grid-template-columns: 1fr 1fr; } }

.risks-list-column {
  display: flex;
  flex-direction: column;
  gap: var(--ph-space-sm);
}

.risk-item {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-md);
  padding: var(--ph-space-md);
  display: flex;
  gap: var(--ph-space-sm);
  align-items: flex-start;
  position: relative;
  box-shadow: var(--ph-shadow-inner-highlight);
  transition: border-color var(--ph-duration-fast) var(--ph-ease-out);
}
.risk-item:hover { border-color: var(--ph-border-hover); }
.risk-item-icon {
  width: 40px; height: 40px;
  border-radius: var(--ph-radius-sm);
  background: var(--ph-warning-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ph-icon-md);
  flex-shrink: 0;
}
.risk-item-text h4 {
  font: var(--ph-text-h4);
  color: var(--ph-text-primary);
  margin-bottom: var(--ph-space-3xs);
}
.risk-item-text p {
  font: var(--ph-text-body-sm);
  color: var(--ph-text-secondary);
  margin: 0;
}
.risk-item-number {
  position: absolute;
  top: var(--ph-space-sm); right: var(--ph-space-sm);
  font: var(--ph-font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--ph-text-muted);
  opacity: 0.15;
}

.risks-illustration {
  position: sticky;
  top: 88px;
}
.risks-illustration img {
  width: 100%;
  height: auto;
  border-radius: var(--ph-radius-lg);
}
.risks-illustration-badge {
  margin-top: var(--ph-space-sm);
  text-align: center;
  font: var(--ph-text-caption);
  color: var(--ph-warning);
}

/* ═══════════ 3. TARGET USERS (4-col grid) ═══════════ */
.target-container {
  max-width: var(--ph-container-wide);
  margin: 0 auto;
  padding: 0 var(--ph-space-md);
}
@media (max-width: 767px) { .target-container { padding: 0 var(--ph-space-sm); } }

.target-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-grid-gap-mobile);
}
@media (min-width: 480px) { .target-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .target-grid { grid-template-columns: repeat(4, 1fr); gap: var(--ph-grid-gap-desktop); } }

/* ═══════════ 4. SMART DEVICES (3-col feature grid + CTA) ═══════════ */
.smart-devices-section { background: var(--ph-bg-secondary); }
.smart-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-grid-gap-mobile);
  margin-bottom: var(--ph-space-xl);
}
@media (min-width: 640px) { .smart-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .smart-grid { grid-template-columns: repeat(3, 1fr); gap: var(--ph-grid-gap-desktop); } }
.smart-cta {
  display: flex;
  gap: var(--ph-space-sm);
  justify-content: center;
  flex-wrap: wrap;
}

/* ═══════════ 5. DOWNLOAD (2-col QR cards) ═══════════ */
.download-container {
  max-width: var(--ph-container-default);
  margin: 0 auto;
  text-align: center;
  padding: 0 var(--ph-space-md);
}
.download-options {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-space-xl);
  margin-bottom: var(--ph-space-lg);
}
@media (min-width: 768px) { .download-options { grid-template-columns: 1fr 1fr; } }
.download-option {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-lg);
  padding: var(--ph-space-lg);
  text-align: center;
  box-shadow: var(--ph-shadow-inner-highlight);
}
.qrcode-wrapper {
  width: 180px; height: 180px;
  margin: 0 auto var(--ph-space-md);
  background: white;
  border-radius: var(--ph-radius-md);
  padding: var(--ph-space-sm);
  display: flex; align-items: center; justify-content: center;
}
.qrcode-wrapper img { width: 100%; height: 100%; object-fit: contain; }
.download-info h3 { font: var(--ph-text-h3); margin-bottom: var(--ph-space-xs); }
.download-meta {
  display: flex;
  flex-direction: column;
  gap: var(--ph-space-3xs);
  font: var(--ph-text-body-sm);
  color: var(--ph-text-secondary);
  margin-bottom: var(--ph-space-md);
}
.download-btn-large {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--ph-space-2xs);
  height: 48px;
  padding: 0 var(--ph-space-lg);
  background: var(--ph-accent);
  color: var(--ph-text-on-accent);
  border: none;
  border-radius: var(--ph-radius-sm);
  font: var(--ph-text-button);
  cursor: pointer;
  text-decoration: none;
  transition: background var(--ph-duration-fast) var(--ph-ease-out),
              transform var(--ph-duration-fast) var(--ph-ease-spring);
}
.download-btn-large:hover { background: var(--ph-accent-hover); transform: translateY(-1px); color: white; }
.download-btn-large:active { transform: scale(0.98); }
.download-btn-large.h5-btn { background: var(--ph-success); }
.download-btn-large.h5-btn:hover { background: var(--ph-gauge-success); }

/* ═══════════ 6. FEATURES (5-col monitoring stats) ═══════════ */
.features-section { background: var(--ph-bg-secondary); }
.features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-grid-gap-mobile);
}
@media (min-width: 480px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 768px) { .features-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1024px) { .features-grid { grid-template-columns: repeat(5, 1fr); gap: var(--ph-grid-gap-desktop); } }

/* ═══════════ 7. DEVICE MANAGEMENT (text left + list right) ═══════════ */
.device-section { background: var(--ph-bg-primary); }
.device-content {
  max-width: var(--ph-container-default);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-space-xl);
  align-items: start;
  padding: 0 var(--ph-space-md);
}
@media (max-width: 767px) { .device-content { padding: 0 var(--ph-space-sm); } }
@media (min-width: 768px) { .device-content { grid-template-columns: 1fr 1fr; } }
.device-text h3 {
  font: var(--ph-text-h2);
  margin-bottom: var(--ph-space-sm);
  letter-spacing: var(--ph-tracking-tight);
}
.device-text p {
  font: var(--ph-text-body);
  color: var(--ph-text-secondary);
  margin-bottom: var(--ph-space-sm);
}
.device-list {
  display: flex;
  flex-direction: column;
  gap: var(--ph-space-2xs);
}
.device-item {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-md);
  padding: var(--ph-space-sm) var(--ph-space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ph-space-sm);
  box-shadow: var(--ph-shadow-inner-highlight);
  transition: border-color var(--ph-duration-fast) var(--ph-ease-out);
}
.device-item:hover { border-color: var(--ph-border-hover); }
.device-info { display: flex; align-items: center; gap: var(--ph-space-sm); }
.device-icon {
  width: 42px; height: 42px;
  border-radius: var(--ph-radius-sm);
  background: var(--ph-bg-tertiary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--ph-icon-lg);
  flex-shrink: 0;
}
.device-details h4 { font: var(--ph-text-h4); margin-bottom: 1px; }
.device-details p { font: var(--ph-text-caption); color: var(--ph-text-muted); margin: 0; }
.device-status {
  display: flex;
  align-items: center;
  gap: var(--ph-space-2xs);
  font: var(--ph-text-caption);
  color: var(--ph-success);
  flex-shrink: 0;
}
.status-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--ph-success);
}

/* ═══════════ 8. ALARM SYSTEM (5-col warning cards) ═══════════ */
.alarm-section { background: var(--ph-bg-secondary); }
.alarm-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-grid-gap-mobile);
}
@media (min-width: 480px) { .alarm-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .alarm-grid { grid-template-columns: repeat(5, 1fr); gap: var(--ph-grid-gap-desktop); } }
.alarm-card {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-lg);
  padding: var(--ph-space-md);
  text-align: center;
  box-shadow: var(--ph-shadow-inner-highlight);
  transition: border-color var(--ph-duration-fast) var(--ph-ease-out),
              box-shadow var(--ph-duration-fast) var(--ph-ease-out);
}
.alarm-card:hover {
  border-color: var(--ph-warning);
  box-shadow: var(--ph-shadow-inner-highlight), 0 0 0 1px var(--ph-warning-subtle);
}
.alarm-header { margin-bottom: var(--ph-space-xs); }
.alarm-icon { font-size: var(--ph-icon-2xl); margin-bottom: var(--ph-space-2xs); }
.alarm-title { font: var(--ph-text-h4); color: var(--ph-text-primary); }
.alarm-description { font: var(--ph-text-caption); color: var(--ph-text-muted); }

/* ═══════════ 9. NOTIFICATION & CONTROLS (phone left + panel right) ═══════════ */
.notification-content {
  max-width: var(--ph-container-default);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-space-xl);
  align-items: center;
  padding: 0 var(--ph-space-md);
}
@media (max-width: 767px) { .notification-content { padding: 0 var(--ph-space-sm); } }
@media (min-width: 768px) { .notification-content { grid-template-columns: 1fr 1fr; } }
.phone-notification { display: flex; justify-content: center; }
.notification-bar {
  padding: var(--ph-space-md);
  background: rgba(255, 255, 255, 0.03);
  border-radius: var(--ph-radius-md);
  text-align: center;
}
[data-theme="light"] .notification-bar { background: rgba(0,0,0,0.02); }
.notification-header {
  display: flex;
  justify-content: space-between;
  font: var(--ph-text-caption);
  color: var(--ph-text-muted);
  margin-bottom: var(--ph-space-xs);
}
.notification-title {
  font: var(--ph-text-h4);
  color: var(--ph-warning);
  margin-bottom: var(--ph-space-2xs);
}
.notification-message {
  font: var(--ph-text-body-sm);
  color: var(--ph-text-secondary);
  margin-bottom: var(--ph-space-xs);
}
.notification-time { font: var(--ph-text-caption); color: var(--ph-text-muted); }

.controls-panel { display: flex; flex-direction: column; gap: var(--ph-space-md); }
.control-group h3 {
  font: var(--ph-text-h3);
  margin-bottom: var(--ph-space-sm);
}
.control-card {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-lg);
  padding: var(--ph-space-md);
  box-shadow: var(--ph-shadow-inner-highlight);
}
.control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--ph-space-md);
}
.control-label { font: var(--ph-text-h4); margin-bottom: var(--ph-space-3xs); }
.control-description { font: var(--ph-text-caption); color: var(--ph-text-muted); }

/* ═══════════ 10. SETTINGS (4-col slider cards) ═══════════ */
.settings-section { background: var(--ph-bg-secondary); }
.settings-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--ph-grid-gap-mobile);
}
@media (min-width: 480px) { .settings-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .settings-grid { grid-template-columns: repeat(4, 1fr); gap: var(--ph-grid-gap-desktop); } }
.setting-card {
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-lg);
  padding: var(--ph-space-md);
  box-shadow: var(--ph-shadow-inner-highlight);
}
.setting-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--ph-space-sm);
}
.setting-title { font: var(--ph-text-h4); }
.setting-value {
  font: var(--ph-font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--ph-text-accent);
}
.setting-footer {
  display: flex;
  justify-content: space-between;
  font: var(--ph-text-caption);
  color: var(--ph-text-muted);
  margin-top: var(--ph-space-2xs);
}

/* ═══════════ SKELETON LOADING (for async sections) ═══════════ */
.skeleton {
  background: linear-gradient(90deg, var(--ph-surface-primary) 25%, var(--ph-surface-secondary) 50%, var(--ph-surface-primary) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s infinite;
  border-radius: var(--ph-radius-sm);
}
@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ═══════════ SECTION DIVIDER (occasional visual break) ═══════════ */
.section-divider {
  width: 60px; height: 2px;
  background: var(--ph-accent);
  margin: 0 auto var(--ph-space-lg);
  border-radius: 1px;
  opacity: 0.5;
}
