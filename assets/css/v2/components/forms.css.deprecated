/* ================================
   Forms & Filters — Phượng Hoàng V2
   Inputs, Select, Textarea, Search,
   Filter Pills, Toggle Switch
   ================================ */

/* ── Form Group ── */
.form-group {
  margin-bottom: var(--ph-space-md);
}

.form-label {
  display: block;
  font: var(--ph-text-caption);
  font-weight: 500;
  color: var(--ph-text-secondary);
  margin-bottom: var(--ph-space-2xs);
}

.form-label .required {
  color: var(--ph-danger);
  margin-left: 2px;
}

/* ── Text Input / Select / Textarea ── */
.form-input,
.form-select,
.form-textarea {
  width: 100%;
  padding: 0 var(--ph-space-sm);
  background: var(--ph-surface-primary);
  border: var(--ph-border-width-medium) solid var(--ph-border-default);
  border-radius: var(--ph-radius-sm);
  font: var(--ph-text-body);
  color: var(--ph-text-primary);
  transition: border-color var(--ph-duration-fast) var(--ph-ease-out);
}

.form-input::placeholder,
.form-textarea::placeholder {
  color: var(--ph-text-muted);
}

.form-input:hover,
.form-select:hover,
.form-textarea:hover {
  border-color: var(--ph-border-hover);
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: var(--ph-border-active);
}

.form-input {
  height: 44px;
}

.form-select {
  height: 44px;
  cursor: pointer;
}

.form-textarea {
  min-height: 120px;
  padding: var(--ph-space-sm);
  resize: vertical;
}

/* ── Error State ── */
.form-input.error,
.form-select.error,
.form-textarea.error {
  border-color: var(--ph-danger);
}

.form-error {
  display: flex;
  align-items: center;
  gap: var(--ph-space-2xs);
  margin-top: var(--ph-space-2xs);
  font: var(--ph-text-caption);
  color: var(--ph-danger);
}

/* ── Disabled ── */
.form-input:disabled,
.form-select:disabled,
.form-textarea:disabled {
  background: var(--ph-bg-tertiary);
  opacity: var(--ph-opacity-disabled);
  cursor: not-allowed;
}

/* ── Search Bar ── */
.search-wrap {
  position: relative;
  max-width: 480px;
  margin: 0 auto var(--ph-space-md);
}

.search-wrap .form-input {
  padding-left: 44px;
  border-radius: var(--ph-radius-full);
  height: 44px;
}

.search-icon {
  position: absolute;
  left: var(--ph-space-sm);
  top: 50%;
  transform: translateY(-50%);
  width: var(--ph-icon-sm);
  height: var(--ph-icon-sm);
  color: var(--ph-text-muted);
  pointer-events: none;
}

/* ── Filter Pills ── */
.filters {
  display: flex;
  flex-wrap: wrap;
  gap: var(--ph-space-2xs);
  justify-content: center;
  margin-bottom: var(--ph-space-lg);
}

@media (max-width: 767px) {
  .filters {
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-start;
    padding-bottom: var(--ph-space-2xs);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .filters::-webkit-scrollbar {
    display: none;
  }
}

.filter-btn {
  height: 36px;
  padding: 0 var(--ph-space-sm);
  font: var(--ph-text-caption);
  font-weight: 600;
  background: transparent;
  border: var(--ph-border-width-thin) solid var(--ph-border-default);
  border-radius: var(--ph-radius-full);
  color: var(--ph-text-secondary);
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--ph-duration-fast) var(--ph-ease-out);
}

.filter-btn:hover {
  border-color: var(--ph-border-hover);
  color: var(--ph-text-primary);
}

.filter-btn.active {
  background: var(--ph-accent);
  border-color: var(--ph-accent);
  color: var(--ph-text-inverse);
}

/* ── Toggle Switch ── */
.toggle-switch {
  position: relative;
  width: 52px;
  height: 28px;
  background: var(--ph-bg-tertiary);
  border: none;
  border-radius: var(--ph-radius-full);
  cursor: pointer;
  transition: background var(--ph-duration-fast) var(--ph-ease-out);
  flex-shrink: 0;
}

.toggle-switch.active {
  background: var(--ph-accent);
}

.toggle-slider {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 22px;
  height: 22px;
  background: white;
  border-radius: 50%;
  transition: transform var(--ph-duration-fast) var(--ph-ease-spring);
}

.toggle-switch.active .toggle-slider {
  transform: translateX(24px);
}

/* ── Slider (Range) ── */
.setting-slider {
  width: 100%;
  height: 6px;
  -webkit-appearance: none;
  appearance: none;
  background: var(--ph-bg-tertiary);
  border-radius: var(--ph-radius-full);
  outline: none;
  margin: var(--ph-space-sm) 0;
}

.setting-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  background: var(--ph-accent);
  border-radius: 50%;
  cursor: pointer;
  box-shadow: var(--ph-shadow-1);
  transition: transform var(--ph-duration-instant) var(--ph-ease-out);
}

.setting-slider::-webkit-slider-thumb:active {
  transform: scale(1.2);
}
