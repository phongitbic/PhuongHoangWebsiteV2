<header class="site-header">
  <div class="header-inner">
    <a class="brand-mark" href="phong.html">
      <img src="assets/logo/Logofinal.png" alt="Logo Công ty TNHH Khoa Học Kỹ Thuật Phượng Hoàng" data-i18n-alt="header.logoAlt">
      <span class="brand-text" data-i18n="header.title">Thiết bị điện an toàn thông minh</span>
    </a>
    <nav class="navbar-links" data-i18n-aria="header.navAria" aria-label="Primary navigation">
      <a class="nav-link" href="phong.html" data-i18n="header.home">Trang chủ</a>
      <a class="nav-link" href="about-us.html" data-i18n="header.about">Về chúng tôi</a>
      <div class="nav-item dropdown">
        <button class="dropdown-toggle" type="button" data-i18n="header.product" onclick="location.href='products.html'">Sản phẩm</button>
        <div class="dropdown-menu">
          <a class="dropdown-item" href="products.html?category=industrial">
            <span class="dropdown-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg></span>
            <span class="dropdown-text">
              <span class="dropdown-title" data-i18n="header.productIndustrial">Thiết bị an toàn điện Công nghiệp</span>
              <span class="dropdown-desc" data-i18n="header.productIndustrialDesc">Nhà máy, xí nghiệp, khu công nghiệp</span>
            </span>
          </a>
          <a class="dropdown-item" href="products.html?category=domestic">
            <span class="dropdown-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
            <span class="dropdown-text">
              <span class="dropdown-title" data-i18n="header.productResidential">Thiết bị an toàn điện Dân dụng</span>
              <span class="dropdown-desc" data-i18n="header.productResidentialDesc">Hộ gia đình, chung cư, văn phòng</span>
            </span>
          </a>
          <a class="dropdown-item" href="products.html?category=surge">
            <span class="dropdown-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
            <span class="dropdown-text">
              <span class="dropdown-title" data-i18n="header.productShock">Thiết bị chống sốc điện cách ly</span>
              <span class="dropdown-desc" data-i18n="header.productShockDesc">Chống sét, cách ly, UPS, SPD</span>
            </span>
          </a>
          <a class="dropdown-item" href="products.html?category=arc">
            <span class="dropdown-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
            <span class="dropdown-text">
              <span class="dropdown-title" data-i18n="header.productArc">Thiết bị dập tia hồ quang điện</span>
              <span class="dropdown-desc" data-i18n="header.productArcDesc">AFDD, dập hồ quang, giám sát</span>
            </span>
          </a>
        </div>
      </div>
      <a class="nav-link" href="distribution-system.html" data-i18n="header.distribution">Hệ thống phân phối</a>
      <a class="nav-link" href="certificates.html" data-i18n="header.certificates">Chứng chỉ</a>
      <a class="nav-link" href="projects.html" data-i18n="header.projects">Công trình</a>
      <a class="nav-link" href="news.html" data-i18n="header.news">Tin tức</a>
      <a class="nav-link" href="contact.html" data-i18n="header.contact">Liên hệ</a>
    </nav>
    <div class="lang-switcher">
      <button class="lang-btn" type="button" onclick="setLanguage('zh')" data-i18n="lang.zh">中文</button>
      <button class="lang-btn" type="button" onclick="setLanguage('en')" data-i18n="lang.en">English</button>
      <button class="lang-btn active" type="button" onclick="setLanguage('vi')" data-i18n="lang.vi">Tiếng Việt</button>
    </div>
    <button class="mobile-menu-toggle" id="menuToggle" onclick="toggleMobileMenu()" aria-label="Mở menu">
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

